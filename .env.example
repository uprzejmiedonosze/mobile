# Kopiuj do .env i uzupełnij. .env jest w .gitignore (sekrety nie idą do repo).
# Po zmianie .env: zrestartuj serwer z `expo start -c` (Metro wczytuje EXPO_PUBLIC_* przy starcie).

# Model LLM (tymczasowo Muse Spark 1.3 przez OpenRouter)
EXPO_PUBLIC_LLM_MODEL=meta/muse-spark-1.3
# Endpoint OpenAI-compatible
EXPO_PUBLIC_LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Klucz OpenRouter – TYLKO lokalnie, nigdy nie commituj prawdziwego klucza.
# Docelowo klucz ma siedzieć na własnym proxy, nie w APK.
EXPO_PUBLIC_OPENROUTER_KEY=
# Timeout jednego zdjęcia [ms]
EXPO_PUBLIC_LLM_TIMEOUT_MS=90000
# Limit tokenów odpowiedzi (model reasoning zjada budżet na myślenie – poniżej 1500 ucina JSON)
EXPO_PUBLIC_LLM_MAX_TOKENS=2000
# Budżet wizji etap 2 (batch na kandydata musi pokryć też myślenie – stąd 8000)
EXPO_PUBLIC_VISION_MAX_TOKENS=8000
# Budżet crop-retry / weryfikacji bbox
EXPO_PUBLIC_CROP_MAX_TOKENS=1000
# Skalowanie zdjęć przed wysyłką (dłuższy bok, jak analiza_1600 w GROUPING.md)
EXPO_PUBLIC_PHOTO_MAX_WIDTH=1600
EXPO_PUBLIC_PHOTO_COMPRESS=0.72
# Nagłówki OpenRouter (statystyki)
EXPO_PUBLIC_APP_REFERER=https://uprzejmiedonosze-pro.local
EXPO_PUBLIC_APP_TITLE=UD Pro ALPR
# Środowisko backendu UD + Firebase, przełączane razem (src/config.ts).
# staging = domyślne, osobny projekt Firebase/baza niż prod – konto z proda tu nie istnieje.
# prod    = produkcja, prawdziwi użytkownicy.
EXPO_PUBLIC_UD_ENV=staging

# Nadpisania pojedynczych pól (opcjonalne, mają priorytet nad EXPO_PUBLIC_UD_ENV).
# Ustawiaj WSZYSTKIE razem albo żadne – mieszanie np. prod apiKey ze staging authDomain
# kończy się 403 z Firebase (to są różne projekty). Web apiKey jest publiczny z natury.
# EXPO_PUBLIC_UD_BASE=https://staging.uprzejmiedonosze.net
# EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDXgjibECwejzudsm3YBQh3O5ponz7ArtI
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=auth-staging.uprzejmiedonosze.net
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=uprzejmiedonosze-1494607701827
