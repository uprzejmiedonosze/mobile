# Kopiuj do .env (gitignored) i uzupełnij. Ten harness NIE używa klucza aplikacji/backendu UD —
# to osobne konto/klucze, celowo, żeby nie dzielić limitów/quoty produkcji.

# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# https://platerecognizer.com/ — używany tylko do bootstrapu ground truth (tests/eval/groundtruth.ts),
# nie do samej oceny modeli.
PLATERECOGNIZER_TOKEN=
