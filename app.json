{
  "expo": {
    "name": "Uprzejmie Donoszę PRO",
    "slug": "uprzejmie-donosze",
    "scheme": "udpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.uprzejmiedonosze.pro"
    },
    "android": {
      "package": "net.uprzejmiedonosze.pro",
      "adaptiveIcon": {
        "backgroundColor": "#0d7a55",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Wybierz 1–3 zdjęcia pojazdu do zgłoszenia."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Odczyt daty i lokalizacji ze zdjęć wybranych do zgłoszenia.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pokazanie Twojej lokalizacji na mapie przy wskazywaniu miejsca wykroczenia."
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "backgroundColor": "#0d7a55"
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "4a12c35d-2a41-46c3-adee-534b4c692cca"
      }
    },
    "owner": "uprzejmie-donosze"
  }
}
