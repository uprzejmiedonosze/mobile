{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_UD_ENV": "staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_UD_ENV": "prod",
        "EXPO_PUBLIC_SENTRY_ENV": "prod"
      }
    },
    "staging": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_UD_ENV": "staging",
        "EXPO_PUBLIC_SENTRY_ENV": "staging",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "shadow": {
      "extends": "staging",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_UD_ENV": "prod",
        "EXPO_PUBLIC_UD_BASE": "https://shadow.uprzejmiedonosze.net",
        "EXPO_PUBLIC_SENTRY_ENV": "shadow"
      }
    },
    "picker-ab": {
      "extends": "staging",
      "env": {
        "EXPO_PUBLIC_PICKER_AB": "1"
      }
    },
    "staging-play": {
      "autoIncrement": true,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_UD_ENV": "staging",
        "EXPO_PUBLIC_SENTRY_ENV": "staging",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "beta",
        "releaseStatus": "draft"
      }
    },
    "staging-play": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
